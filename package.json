    "@biomejs/biome": "2.0.5",
    "@types/node": "24.0.8",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "0.3.1",
    "typescript": "5.8.3",
    "ultracite": "^5.6.4"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/multipart": "9.0.3",
    "@google/genai": "1.8.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "5.0.1",
    "postgres": "3.4.7",
